# ========================
# FONTES
# ========================
font-family = "JetBrainsMono NFM Regular"
font-family-bold = "JetBrainsMono NFM Bold"
font-family-italic = "JetBrainsMono NFM Italic"
font-family-bold-italic = "JetBrainsMono NFM Bold Italic"

font-size = 14
font-feature = +liga
font-feature = +calt

theme = everforest-dark-medium
window-theme = dark

window-padding-x = 5
window-padding-y = 5
window-padding-balance = true
window-padding-color = background

window-width = 140
window-height = 40


background-opacity = 1.0

# =========================
# Optional
# =========================

shell-integration = fish
copy-on-select = true
confirm-close-surface = false

# =========================
# Navegação entre Splits
# =========================
keybind = ctrl+shift+left=unbind
keybind = ctrl+shift+right=unbind
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right

keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
# =========================
# Redimensionamento de Splits
# =========================
keybind = alt+shift+up=resize_split:up,10
keybind = alt+shift+down=resize_split:down,10
keybind = alt+shift+left=resize_split:left,10
keybind = alt+shift+right=resize_split:right,10
