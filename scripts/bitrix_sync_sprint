#!/usr/bin/env bash
# Sincroniza uma Sprint do Bitrix (dry-run por padrão; use --apply para gravar)

mode=--dry-run
rest=()
for a in "$@"; do
    if [[ $a == --apply ]]; then
        mode=--apply
    else
        rest+=("$a")
    fi
done

exec python3 "$HOME/Documentos/ObsidianVault/scripts/sync_bitrix.py" "$mode" --sprint-id "${rest[@]}"
